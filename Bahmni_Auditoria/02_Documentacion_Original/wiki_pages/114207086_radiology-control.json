    "view": {
      "value": "<div class=\"contentLayout2\">\n<div class=\"columnLayout two-right-sidebar\" data-layout=\"two-right-sidebar\">\n<div class=\"cell normal\" data-type=\"normal\">\n<div class=\"innerCell\">\n<h2 id=\"RadiologyControl-Purpose\">Purpose</h2><p><p class=\"p1 conf-macro output-inline\" data-hasbody=\"true\" data-macro-id=\"638aebc5-f96c-44fe-9484-b0037d832b70\" data-macro-name=\"excerpt\"><span class=\"s1\">Radiology Control</span><span class=\"s2\"> is used to list the Radiology Orders given to the patient for that particular visit. </span></p></p><h2 id=\"RadiologyControl-Screenshot\">Screenshot</h2><p><span class=\"confluence-embedded-file-wrapper confluence-embedded-manual-size\"><img class=\"confluence-embedded-image\" width=\"800\" loading=\"lazy\" src=\"https://bahmni.atlassian.net/wiki/download/thumbnails/114207086/Screen%20Shot%202017-03-03%20at%204.24.24%20PM.png?version=1&amp;modificationDate=1488538737614&amp;cacheVersion=1&amp;api=v2&amp;width=800&amp;height=119\" data-image-src=\"https://bahmni.atlassian.net/wiki/download/attachments/114207086/Screen%20Shot%202017-03-03%20at%204.24.24%20PM.png?version=1&amp;modificationDate=1488538737614&amp;cacheVersion=1&amp;api=v2\" data-unresolved-comment-count=\"0\" data-linked-resource-id=\"115155037\" data-linked-resource-version=\"1\" data-linked-resource-type=\"attachment\" data-linked-resource-default-alias=\"Screen Shot 2017-03-03 at 4.24.24 PM.png\" data-base-url=\"https://bahmni.atlassian.net/wiki\" data-linked-resource-content-type=\"image/png\" data-linked-resource-container-id=\"114207086\" data-linked-resource-container-version=\"5\" data-media-id=\"18bd7fdc-52bb-4408-8c22-6f2cebb9074b\" data-media-type=\"file\" srcset=\"https://bahmni.atlassian.net/wiki/download/thumbnails/114207086/Screen%20Shot%202017-03-03%20at%204.24.24%20PM.png?version=1&amp;modificationDate=1488538737614&amp;cacheVersion=1&amp;api=v2&amp;width=1600&amp;height=238 2x, https://bahmni.atlassian.net/wiki/download/thumbnails/114207086/Screen%20Shot%202017-03-03%20at%204.24.24%20PM.png?version=1&amp;modificationDate=1488538737614&amp;cacheVersion=1&amp;api=v2&amp;width=800&amp;height=119 1x\"></span></p><h2 id=\"RadiologyControl-Configuration\">Configuration</h2><h3 id=\"RadiologyControl-SampleConfig\"><span class=\"inline-comment-marker\" data-ref=\"5db5417f-accb-4936-9afb-c64f5fabf2c4\">Sample Config</span></h3><div class=\"code panel pdl conf-macro output-block\" data-hasbody=\"true\" data-macro-id=\"5bcfd154-07e0-497b-8814-674f8a9a5ac1\" data-macro-name=\"code\" style=\"border-width: 1px;\"><div class=\"codeHeader panelHeader pdl\" style=\"border-bottom-width: 1px;\"><b>Add to clinical/visit.json for it to appear on the patient dashboard</b></div><div class=\"codeContent panelContent pdl\">\n<pre class=\"syntaxhighlighter-pre\" data-syntaxhighlighter-params=\"brush: js; gutter: true; theme: Confluence\" data-theme=\"Confluence\">&quot;radiologyOrderControl&quot;:  {\n        &quot;type&quot;: &quot;order&quot;,\n        &quot;title&quot;: &quot;Radiology Order Display Control&quot;,\n        &quot;config&quot;: {\n                           &quot;title&quot;: &quot;Radiology Order Display Control&quot;,\n                           &quot;name&quot;: &quot;ordersControl&quot;,\n                          &quot;orderType&quot;: &quot;Radiology Order&quot;,\n                          &quot;conceptNames&quot;:[&quot;Systolic&quot;, &quot;Diastolic&quot;, &quot;Posture&quot;, &quot;Temperature&quot;]\n          }\n}</pre>\n</div></div><h3 id=\"RadiologyControl-KeyFieldTable\">Key Field Table</h3><div class=\"table-wrap\"><table class=\"wrapped confluenceTable\"><colgroup><col/><col/><col/></colgroup><tbody><tr><th class=\"confluenceTh\">Key</th><th class=\"confluenceTh\">Info</th><th class=\"confluenceTh\">Mandatory</th></tr><tr><td class=\"confluenceTd\">title</td><td class=\"confluenceTd\"><span>Indicates the title that will be displayed on the dashboard for the section</span></td><td class=\"confluenceTd\">Y</td></tr><tr><td class=\"confluenceTd\">type</td><td class=\"confluenceTd\"><span>The name/type of the display control that needs to be picked from the code</span></td><td class=\"confluenceTd\">Y</td></tr><tr><td colspan=\"1\" class=\"confluenceTd\">OrderType</td><td colspan=\"1\" class=\"confluenceTd\">Only the orders of this type will shown in the display control</td><td colspan=\"1\" class=\"confluenceTd\">Y</td></tr><tr><td colspan=\"1\" class=\"confluenceTd\">ConceptNames</td><td colspan=\"1\" class=\"confluenceTd\">Concepts of observations to be chosen for display</td><td colspan=\"1\" class=\"confluenceTd\">N</td></tr></tbody></table></div></div>\n</div>\n<div class=\"cell aside\" data-type=\"aside\">\n<div class=\"innerCell\">\n<div class=\"confluence-information-macro confluence-information-macro-tip conf-macro output-block\" data-hasbody=\"true\" data-macro-id=\"9e21e6bc-65b4-4f30-a341-0dc091c2e859\" data-macro-name=\"tip\"><p class=\"title\">On this Page</p><span class=\"aui-icon aui-icon-small aui-iconfont-approve confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p> </p><div class=\"toc-macro client-side-toc-macro  conf-macro output-block\" data-hasbody=\"false\" data-headerelements=\"H1,H2,H3,H4,H5,H6,H7\" data-macro-id=\"c600f8c4-b8b4-4eb8-bd41-e903ed368a03\" data-macro-name=\"toc\"> </div><p> </p></div></div><div class=\"panel conf-macro output-block\" data-hasbody=\"true\" data-macro-id=\"11c594ed-5883-4869-a352-0f4f6562d86e\" data-macro-name=\"panel\" style=\"border-width: 1px;\"><div class=\"panelHeader\" style=\"border-bottom-width: 1px;background-color: #1FA5A0;color: White;\"><b>Related Display Controls</b></div><div class=\"panelContent\">\n<p> </p><ul class=\"childpages-macro conf-macro output-block\" data-hasbody=\"false\" data-macro-id=\"3bab2c96-015b-4fef-9741-4a7fda76b880\" data-macro-name=\"children\"><li><a href=\"/wiki/spaces/BAH/pages/114206168/Bacteriology+Results+Control\" data-linked-resource-id=\"114206168\" data-linked-resource-version=\"6\" data-linked-resource-type=\"page\">Bacteriology Results Control</a></li><li><a href=\"/wiki/spaces/BAH/pages/114206305/Lab+Order+Control\" data-linked-resource-id=\"114206305\" data-linked-resource-version=\"11\" data-linked-resource-type=\"page\">Lab Order Control</a></li><li><a href=\"/wiki/spaces/BAH/pages/114206500/Order+Fulfillment+Control\" data-linked-resource-id=\"114206500\" data-linked-resource-version=\"9\" data-linked-resource-type=\"page\">Order Fulfillment Control</a></li><li><a href=\"/wiki/spaces/BAH/pages/114206820/PACS+Orders+Control\" data-linked-resource-id=\"114206820\" data-linked-resource-version=\"5\" data-linked-resource-type=\"page\">PACS Orders Control</a></li><li><a href=\"/wiki/spaces/BAH/pages/114207086/Radiology+Control\" data-linked-resource-id=\"114207086\" data-linked-resource-version=\"5\" data-linked-resource-type=\"page\">Radiology Control</a></li></ul><p> </p>\n</div></div></div>\n</div>\n</div>\n</div>",
