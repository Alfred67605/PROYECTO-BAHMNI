    "storage": {
      "value": "<ac:layout><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><h2>About the Feature</h2><p>Admin module has features like <a href=\"https://bahmni.atlassian.net/wiki/display/BAH/Import+Data\">CSV Upload</a>, <a href=\"https://bahmni.atlassian.net/wiki/display/BAH/Export+Data\">CSV Export</a> and <a href=\"https://bahmni.atlassian.net/wiki/display/BAH/Authoring+Order+Sets\">Order Set</a>.</p><h2><span style=\"color: rgb(0,0,0);\">Used By</span></h2><p><span style=\"color: rgb(0,0,0);\">Administrator of the hospital uses this feature.</span></p><h2><span style=\"color: rgb(0,0,0);\">How is it Used?</span></h2><p><span style=\"color: rgb(0,0,0);\">Select the Admin module from the home dashboard to use it.</span></p><p><span style=\"color: rgb(0,0,0);\"><ac:image ac:height=\"400\"><ri:attachment ri:filename=\"Screen Shot 2016-04-15 at 1.17.27 pm.png\" /></ac:image>&nbsp;</span></p><p><span style=\"color: rgb(0,0,0);\">On accessing the Admin module, three options will be available. Please refer to the links below on using them</span></p><p><span style=\"color: rgb(0,0,0);\"><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"23cf5595-a582-48cb-a399-ce95c42236f0\" /><br /></span></p><p><span style=\"color: rgb(0,0,0);\"><br /></span></p></ac:layout-cell><ac:layout-cell><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"6462b5e2-1d86-451d-a8c5-c39c2f99335c\"><ac:rich-text-body><p><strong><span style=\"color: rgb(0,0,0);\">Bahmni configuration for each implementation can vary drastically. The screens and workflows may not be constant across all installations of Bahmni.</span></strong></p></ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"af80166f-61d3-4ee1-a7f9-d1ea0b9c28c4\"><ac:parameter ac:name=\"title\">Sections</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"0c945e18-35b4-47d3-a0b5-8d1378540c40\" /></p></ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"0add60ca-db50-405a-bfd6-90945fbc2b0b\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Feature Details</ac:parameter><ac:rich-text-body><p><span style=\"color: rgb(0,0,0);\"><ac:link><ri:page ri:content-title=\"Administrator's Page\" /><ac:plain-text-link-body><![CDATA[Admin Page - Feature Guide]]></ac:plain-text-link-body></ac:link></span></p></ac:rich-text-body></ac:structured-macro><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"3fe3feef-06ea-4aac-b9a1-a6bbe83b0bec\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Implemnentation Details</ac:parameter><ac:rich-text-body><p><span style=\"color: rgb(0,0,0);\"><ac:link><ri:page ri:content-title=\"Bahmni Administration\" /><ac:plain-text-link-body><![CDATA[Admin Page - Implementer's Guide]]></ac:plain-text-link-body></ac:link></span></p></ac:rich-text-body></ac:structured-macro></ac:layout-cell></ac:layout-section></ac:layout>",
