      "value": "<ac:layout><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><h2>Purpose and Benefits</h2><p><span style=\"color: rgb(0,0,0);\">&nbsp;</span><span style=\"color: rgb(0,0,0);\">&lt;Introductory line taken directly from the FG&gt;</span></p><h2><span style=\"color: rgb(0,0,0);\">Steps</span></h2><p><span style=\"color: rgb(0,0,0);\">&lt;4-5 granular steps to implementing it. <strong>Each step should be accompanied with details, a screenshot and code snippets as required. </strong></span><span style=\"color: rgb(0,0,0);\">If a screenshot is not part of the OOTB Bahmni implementation, call it out as such.&gt;</span></p><h3><span style=\"color: rgb(0,0,0);\">1. Configure XYZ Tab</span></h3><p><span style=\"color: rgb(0,0,0);\"><ac:image ac:align=\"center\" ac:width=\"700\"><ri:attachment ri:filename=\"Screen Shot 2015-11-10 at 10.55.06.png\" ri:version-at-save=\"2\"><ri:page ri:content-title=\"Clinical Services\" ri:version-at-save=\"48\" /></ri:attachment></ac:image></span></p><p style=\"text-align: center;\"><span style=\"color: rgb(0,0,0);\"><strong>Image resolution 700px. Image and Caption centered in Bold.</strong></span></p><p style=\"text-align: left;\"><span style=\"color: rgb(0,0,0);\">Please refer to the code snippet below:<br /></span></p><ac:structured-macro ac:name=\"code\" ac:schema-version=\"1\" ac:macro-id=\"5d36357b-dbd4-4515-b88e-170a9e304ecd\"><ac:parameter ac:name=\"language\">js</ac:parameter><ac:parameter ac:name=\"linenumbers\">true</ac:parameter><ac:plain-text-body><![CDATA[Please set Language to Javascript and linenumbers to true\nPlease remove all blank lines using this link http://textmechanic.com/Remove-Empty-Lines.html]]></ac:plain-text-body></ac:structured-macro><h2><span>Key Fields&nbsp;</span></h2><p><span>&lt;<span style=\"color: rgb(0,0,0);\">Any Key Fields. Highlight Mandatory Fields/Attributes with an asterisk. </span></span></p><p><span><span style=\"color: rgb(0,0,0);\"><strong><a href=\"https://docs.google.com/spreadsheets/d/1iLn15MpxxTAnkzU_GS0ZR906bGZnGEzl2dicsilU0ak/edit#gid=0\">Please add all key fields to the Glossary here</a></strong>&gt;</span></span></p><table class=\"wrapped\"><tbody><tr><th>Key</th><th>Use</th><th>Mandatory</th></tr><tr><td><br /></td><td><br /></td><td><br /></td></tr><tr><td><br /></td><td><br /></td><td><br /></td></tr><tr><td><br /></td><td><br /></td><td><br /></td></tr></tbody></table><h2><span style=\"color: rgb(0,0,0);font-size: 20.0px;line-height: 1.5;\">Data Setup</span></h2><p><span style=\"color: rgb(0,0,0);\">&lt;Links to any prior config / master data setup.&gt;</span></p><p><br /></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"e6921b04-2089-48cb-990e-45bb5d87af22\"><ac:parameter ac:name=\"icon\">false</ac:parameter><ac:parameter ac:name=\"title\">On this Page</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"toc\" ac:schema-version=\"1\" ac:macro-id=\"0b744f92-0474-4511-ba50-ea4dc8343d16\"><ac:parameter ac:name=\"style\">none</ac:parameter></ac:structured-macro></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"0add60ca-db50-405a-bfd6-90945fbc2b0b\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Feature Details</ac:parameter><ac:rich-text-body><p><span style=\"color: rgb(0,0,0);\"><ac:link><ri:page ri:content-title=\"Feature Guide\" ri:version-at-save=\"22\" /><ac:plain-text-link-body><![CDATA[<Page Name> - Feature Guide]]></ac:plain-text-link-body></ac:link></span></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"b94e3ad7-5c3a-4de1-9e38-0d0d4195b78d\"><ac:parameter ac:name=\