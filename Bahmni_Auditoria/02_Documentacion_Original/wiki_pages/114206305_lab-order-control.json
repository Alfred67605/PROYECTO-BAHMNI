ri:filename=\"Screenshot 2024-02-28 at 4.46.33 PM.png\" ri:version-at-save=\"1\" /></ac:image></p></div></td></tr><tr><td colspan=\"1\">&quot;showChart&quot;: true,<br />&quot;chartConfig&quot;: {&nbsp; &nbsp; &nbsp; &nbsp;&quot;sortResultColumnsLatestFirst&quot;: false,<br />}</td><td colspan=\"1\"><div class=\"content-wrapper\"><p><ac:image ac:width=\"800\"><ri:attachment ri:filename=\"Screenshot 2024-02-28 at 4.48.55 PM.png\" ri:version-at-save=\"1\" /></ac:image></p></div></td></tr><tr><td colspan=\"1\"><p>&quot;showChart&quot;: true, <br />&quot;chartConfig&quot;: {&nbsp; &nbsp;&quot;sortResultColumnsLatestFirst&quot;: true,<br />&nbsp;&quot;groupByPanel&quot;: true <br />}</p></td><td colspan=\"1\"><ac:image ac:width=\"800\"><ri:url ri:value=\"https://bahmni.atlassian.net/wiki/download/attachments/114206305/Screenshot%202024-02-28%20at%204.54.48%E2%80%AFPM.png?version=1&amp;modificationDate=1709119494267&amp;cacheVersion=1&amp;api=v2\" /></ac:image></td></tr><tr><td colspan=\"1\"><div class=\"content-wrapper\"><p>&quot;showChart&quot;: true, <br />&quot;chartConfig&quot;: {&nbsp; &nbsp;&quot;sortResultColumnsLatestFirst&quot;: true,<br />&nbsp;&quot;groupByPanel&quot;: false<br />}</p></div></td><td colspan=\"1\"><ac:image ac:width=\"800\"><ri:attachment ri:filename=\"Screenshot 2024-02-28 at 5.02.20 PM.png\" ri:version-at-save=\"1\" /></ac:image></td></tr></tbody></table><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"9e21e6bc-65b4-4f30-a341-0dc091c2e859\"><ac:parameter ac:name=\"title\">On this Page</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"toc\" ac:schema-version=\"1\" ac:macro-id=\"c600f8c4-b8b4-4eb8-bd41-e903ed368a03\" /></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"11c594