    "storage": {
      "value": "<ac:layout><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><h2>Enabling the new Bed Management Module</h2><p>You can enable the new BM by configuring it as an extension in <em>bahmni_config/home/extension.json&nbsp;</em>like below or as configured in <a href=\"https://github.com/Bahmni/default-config/blob/master/openmrs/apps/home/extension.json#L42\">default config here</a></p><ac:structured-macro ac:name=\"code\" ac:schema-version=\"1\" ac:macro-id=\"38a2ffc9-7872-45bd-8cdd-5d359a7f3a7a\"><ac:parameter ac:name=\"title\">App Extension Definition</ac:parameter><ac:plain-text-body><![CDATA[\"newBedManagement\": {\n    \"id\": \"bahmni.ipd\",\n    \"extensionPointId\": \"org.bahmni.home.dashboard\",\n    \"type\": \"link\",\n    \"translationKey\": \"MODULE_LABEL_BED_MANAGEMENT_KEY\",\n    \"label\": \"InPatient\",\n    \"url\": \"../bedmanagement/#/home\",\n    \"icon\": \"fa-bed\",\n    \"order\": 7,\n    \"requiredPrivilege\": \"app:adt\"\n }]]></ac:plain-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><p class=\"auto-cursor-target\"><strong>NOTE:</strong> For Ward Layout, bed management and bed-types please refer this documentation: <ac:link><ri:page ri:content-title=\"Ward Management Admin Console\" ri:version-at-save=\"5\" /><ac:plain-text-link-body><![CDATA[Ward Management (Admin)]]></ac:plain-text-link-body></ac:link></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"e6921b04-2089-48cb-990e-45bb5d87af22\"><ac:parameter ac:name=\"icon\">false</ac:parameter><ac:parameter ac:name=\"title\">On this Page</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"toc\" ac:schema-version=\"1\" ac:macro-id=\"0b744f92-0474-4511-ba50-ea4dc8343d16\"><ac:parameter ac:name=\"style\">none</ac:parameter></ac:structured-macro></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"75cc2741-ab64-44c9-b537-0a202bfb8299\"><ac:parameter ac:name=\"icon\">false</ac:parameter><ac:parameter ac:name=\"title\">Sections</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"28bbf201-d4bb-472c-865e-0ceb60581fb2\"><ac:parameter ac:name=\"all\">true</ac:parameter></ac:structured-macro></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"698d4a82-5bc7-4a13-a03e-2c6d4414d8f7\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#1FA5A0</ac:parameter><ac:parameter ac:name=\"title\">Related Links</ac:parameter><ac:rich-text-body><p><ac:link><ri:page ri:content-title=\"Ward Management Admin Console\" ri:version-at-save=\"5\" /></ac:link></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"0add60ca-db50-405a-bfd6-90945fbc2b0b\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Feature Details</ac:parameter><ac:rich-text-body><p><ac:link><ri:page ri:content-title=\"Bed Management (BM)\" ri:version-at-save=\"16\" /><ac:plain-text-link-body><![CDATA[Bed Management - Feature Guide]]></ac:plain-text-link-body></ac:link></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"b94e3ad7-5c3a-4de1-9e38-0d0d4195b78d\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Usage Details</ac:parameter><ac:rich-text-body><p><ac:link><ri:page ri:content-title=\"Bed Management\" ri:version-at-save=\"12\" /><ac:plain-text-link-body><![CDATA[Bed Management - User Guide]]></ac:plain-text-link-body></ac:link></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell></ac:layout-section></ac:layout>",
