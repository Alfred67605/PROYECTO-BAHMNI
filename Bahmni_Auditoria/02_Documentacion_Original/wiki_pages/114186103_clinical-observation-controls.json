      "value": "<ac:layout><ac:layout-section ac:type=\"single\"><ac:layout-cell><ac:structured-macro ac:name=\"warning\" ac:schema-version=\"1\" ac:macro-id=\"d5207275-4ee0-4a3d-bf39-85fa8f7980f8\"><ac:rich-text-body><p>This guide is currently In-Progress. Over the next few months, content will be added to it.&nbsp;</p><p>If you have any suggestions or would like to add pages which talk about the functionality of Bahmni, please feel free to add them.</p></ac:rich-text-body></ac:structured-macro></ac:layout-cell></ac:layout-section><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"0e222c07-7b12-4b25-a279-ec4df0626055\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#1FA5A0</ac:parameter><ac:parameter ac:name=\"title\">List of Clinical Observation Controls</ac:parameter><ac:rich-text-body><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"99ee7e2f-e138-47ef-bc99-437260bcafb7\"><ac:parameter ac:name=\"all\">true</ac:parameter><ac:parameter ac:name=\"excerptType\">rich content</ac:parameter></ac:structured-macro></ac:rich-text-body></ac:structured-macro><p><br /></p><p><br /></p></ac:layout-cell><ac:layout-cell><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"12fa8209-6fd4-4f12-8d20-db5632a4a86f\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#1FA5A0</ac:parameter><ac:parameter ac:name=\"title\">List of All Display Controls</ac:parameter><ac:rich-text-body><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"536c4073-4f45-4053-9729-0363a8cfd006\"><ac:parameter ac:name=\"all\">true</ac:parameter><ac:parameter ac:name=\"page\"><ac:link><ri:page ri:content-title=\"Display Controls\" /></ac:link></ac:parameter></ac:structured-macro></ac:rich-text-body></ac:structured-macro></ac:layout-cell></ac:layout-section></ac:layout>",
