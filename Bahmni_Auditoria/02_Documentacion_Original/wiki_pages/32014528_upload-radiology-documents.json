    "storage": {
      "value": "<ac:layout><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><h2>About the Feature</h2><p>Bahmni provides functionality to upload radiology documents and associate them to a patient visit. Documents can be uploaded to an already existing visit or a new visit can be created.</p><h2><span style=\"color: rgb(0,0,0);\">Used By</span></h2><p><span style=\"color: rgb(0,0,0);\">Radiology documents are uploaded by radiology technicians and viewed by doctors for diagnostic purposes.</span></p><h2><span style=\"color: rgb(0,0,0);\">How is it Used?</span></h2><ul><li><span style=\"color: rgb(0,0,0);\">Navigate to Radiology upload module from the Bahmni home page and select a patient to upload documents for</span></li></ul><p><span style=\"color: rgb(0,0,0);\"><br /></span></p><p><ac:image ac:align=\"center\" ac:width=\"700\"><ri:attachment ri:filename=\"image2016-4-22 13:0:58.png\" ri:version-at-save=\"1\" /></ac:image></p><p>&nbsp;</p><ul><li><span style=\"color: rgb(0,0,0);line-height: 1.42857;\">On select of a patient you will be taken to the document upload screen. You can upload documents to a new visit by clicking the new visit tab</span></li></ul><p><span style=\"color: rgb(0,0,0);line-height: 1.42857;\"><br /></span></p><p><ac:image ac:align=\"center\" ac:width=\"700\"><ri:attachment ri:filename=\"image2016-4-22 13:14:38.png\" ri:version-at-save=\"1\" /></ac:image><br /><br /><span style=\"color: rgb(0,0,0);\">Click the scan button to upload documents. The type of the uploaded document will have to be selected from the dropdown.&nbsp;</span><span style=\"color: rgb(0,0,0);\">The dates selected should not overlap with any existing visit of the patient. If they do, an error message will be displayed asking the user to upload the document to the appropriate visit.</span><br /><span style=\"color: rgb(0,0,0);\"><br /></span></p><ul><li><span style=\"color: rgb(0,0,0);\">To upload a document to an existing visit, expand the tab of the appropriate visit and upload the document</span></li></ul><p><span style=\"color: rgb(0,0,0);\"><br /></span></p><p><span style=\"color: rgb(0,0,0);\"><ac:image ac:align=\"center\" ac:width=\"700\"><ri:attachment ri:filename=\"image2016-4-22 13:16:2.png\" ri:version-at-save=\"1\" /></ac:image></span><span style=\"color: rgb(0,0,0);\">&nbsp;</span></p><p><span style=\"color: rgb(0,0,0);\">&nbsp;</span></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"fe9e777b-789d-44be-99a5-88941280217a\"><ac:parameter ac:name=\"title\">On this Page</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"toc\" ac:schema-version=\"1\" ac:macro-id=\"1f1c1010-6fb8-4989-95d2-7a04b30f7142\" /></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"0add60ca-db50-405a-bfd6-90945fbc2b0b\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Feature Details</ac:parameter><ac:rich-text-body><p><a href=\"https://bahmni.atlassian.net/wiki/display/BAH/Radiology+and+PACS\">Radiology and PACS - Feature Guide</a></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"e362d9ee-c9aa-4bc5-aa2f-7ad0b6617623\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Implementation Details</ac:parameter><ac:rich-text-body><p><span style=\"color: rgb(0,0,0);\"><a href=\"https://bahmni.atlassian.net/wiki/display/BAH/Manual+Radiology+Upload\">Radiology Upload - Implementer's Guide</a></span></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell></ac:layout-section></ac:layout>",
