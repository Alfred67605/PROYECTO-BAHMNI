    "storage": {
      "value": "<ac:layout><ac:layout-section ac:type=\"single\"><ac:layout-cell><h2>Purpose and Benefits</h2><p>Bahmni Connect&nbsp;allows a user to access Bahmni in areas with limited internet connectivity. This is especially useful for&nbsp;<span class=\"legacy-color-text-default\"><a href=\"https://en.wikipedia.org/wiki/Community_health_worker\">Community Health Workers</a> (CHWs) to use Bahmni to register patients, view medical records, and enter brief treatment data in remote, internet-lacking locations. The CHW can later come into an area with connectivity to a Bahmni server, and&nbsp;<em>synchronize</em>&nbsp;the app on their Android device/Chromebook with the Bahmni server.</span></p><p><span class=\"legacy-color-text-default\"><br /></span></p><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"warning\" ac:schema-version=\"1\" ac:macro-id=\"d0c3232b-cc7d-45af-9915-6449ebaffd63\"><ac:rich-text-body><p>WARNING: Bahmni Connect App is no longer being maintained. Instead please see the Bahmni Outreach App, for Offline-ready, CHW Mobile App here: <ac:link><ri:page ri:content-title=\"Bahmni Outreach App for Community Healthcare (Offline ready)\" ri:version-at-save=\"6\" /></ac:link></p></ac:rich-text-body></ac:structured-macro><p><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"73db817b-a3ca-4db6-811b-7851d15b0b56\"><ac:rich-text-body><p>You can also watch this video walkthrough of the Bahmni Connect app: <a href=\"https://youtu.be/5mzrDE6G2rA\">https://youtu.be/5mzrDE6G2rA</a></p></ac:rich-text-body></ac:structured-macro><p><span class=\"legacy-color-text-default\"><br /></span></p></ac:layout-cell></ac:layout-section><ac:layout-section ac:type=\"three_equal\"><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"75cc2741-ab64-44c9-b537-0a202bfb8299\"><ac:parameter ac:name=\"icon\">false</ac:parameter><ac:parameter ac:name=\"title\">Sections</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"28bbf201-d4bb-472c-865e-0ceb60581fb2\"><ac:parameter ac:name=\"all\">true</ac:parameter></ac:structured-macro></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"f5e76242-9ad1-477e-9fa2-70ff0a12c473\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Feature Details</ac:parameter><ac:rich-text-body><p><ac:link><ri:page ri:content-title=\"Bahmni Connect\" ri:version-at-save=\"40\" /></ac:link></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"b94e3ad7-5c3a-4de1-9e38-0d0d4195b78d\"><ac:parameter ac:name=\"titleColor\">white</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#668D3C</ac:parameter><ac:parameter ac:name=\"title\">Usage Details</ac:parameter><ac:rich-text-body><p><ac:link><ri:page ri:content-title=\"Using Bahmni Connect App\" ri:version-at-save=\"34\" /></ac:link></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell></ac:layout-section></ac:layout>",
