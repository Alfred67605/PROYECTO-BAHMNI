    "view": {
      "value": "<div class=\"contentLayout2\">\n<div class=\"columnLayout two-right-sidebar\" data-layout=\"two-right-sidebar\">\n<div class=\"cell normal\" data-type=\"normal\">\n<div class=\"innerCell\">\n<h2 id=\"AdmissionDetailsControl-Purpose\">Purpose</h2><p><p class=\"p1 conf-macro output-inline\" data-hasbody=\"true\" data-macro-id=\"638aebc5-f96c-44fe-9484-b0037d832b70\" data-macro-name=\"excerpt\"><span class=\"s1\">Admission Details Control is used to list the details of the patient like Bed and Ward number where the patient got assigned, Admission Date and Notes, Discharge Date and Notes details.</span></p><br/></p><h2 id=\"AdmissionDetailsControl-Screenshot\">Screenshot</h2><p><span class=\"legacy-color-text-default\"><span class=\"confluence-embedded-file-wrapper confluence-embedded-manual-size\"><img class=\"confluence-embedded-image\" width=\"600\" loading=\"lazy\" src=\"https://bahmni.atlassian.net/wiki/download/thumbnails/114204313/Screen%20Shot%202016-05-25%20at%204.29.54%20PM.png?version=1&amp;modificationDate=1484657191520&amp;cacheVersion=1&amp;api=v2&amp;width=600&amp;height=130\" data-image-src=\"https://bahmni.atlassian.net/wiki/download/attachments/114204313/Screen%20Shot%202016-05-25%20at%204.29.54%20PM.png?version=1&amp;modificationDate=1484657191520&amp;cacheVersion=1&amp;api=v2\" data-unresolved-comment-count=\"0\" data-linked-resource-id=\"114204294\" data-linked-resource-version=\"1\" data-linked-resource-type=\"attachment\" data-linked-resource-default-alias=\"Screen Shot 2016-05-25 at 4.29.54 PM.png\" data-base-url=\"https://bahmni.atlassian.net/wiki\" data-linked-resource-content-type=\"image/png\" data-linked-resource-container-id=\"114204313\" data-linked-resource-container-version=\"10\" data-media-id=\"2f1f13fe-bea9-48a9-9fc6-6c69ef5f0548\" data-media-type=\"file\" srcset=\"https://bahmni.atlassian.net/wiki/download/thumbnails/114204313/Screen%20Shot%202016-05-25%20at%204.29.54%20PM.png?version=1&amp;modificationDate=1484657191