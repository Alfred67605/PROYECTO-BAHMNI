    "storage": {
      "value": "<ac:layout><ac:layout-section ac:type=\"two_right_sidebar\"><ac:layout-cell><h2>Purpose</h2><ac:structured-macro ac:name=\"excerpt\" ac:schema-version=\"1\" ac:macro-id=\"638aebc5-f96c-44fe-9484-b0037d832b70\"><ac:parameter ac:name=\"atlassian-macro-output-type\">INLINE</ac:parameter><ac:rich-text-body><p class=\"p1\"><span class=\"s1\">Admission Details Control is used to list&nbsp;the details of&nbsp;the patient like Bed and Ward number where the patient got assigned, Admission Date and Notes, Discharge&nbsp;Date and Notes&nbsp;details.</span></p></ac:rich-text-body></ac:structured-macro><p><br /></p><h2>Screenshot</h2><p><span class=\"legacy-color-text-default\"><ac:image ac:width=\"600\"><ri:attachment ri:filename=\"Screen Shot 2016-05-25 at 4.29.54 PM.png\" ri:version-at-save=\"1\" /></ac:image></span></p><h2>Configuration</h2><ac:structured-macro ac:name=\"code\" ac:schema-version=\"1\" ac:macro-id=\"899d5f59-d4c6-4335-a689-6d6c4c3f12c7\"><ac:parameter ac:name=\"language\">js</ac:parameter><ac:parameter ac:name=\"title\">Add to clinical/dashboard.json for it to appear on the patient dashboard</ac:parameter><ac:parameter ac:name=\"linenumbers\">true</ac:parameter><ac:plain-text-body><![CDATA[\"admissionDetails\": {\n    \"title\": \"Admission Details\",\n    \"translationKey\":\"DASHBOARD_TITLE_ADMISSION_DETAILS_KEY\",\n    \"type\": \"admissionDetails\",\n    \"displayOrder\": 19,\n    \"hideEmptyDisplayControl\": false\n}]]></ac:plain-text-body></ac:structured-macro><p><span class=\"legacy-color-text-default\"><br /></span></p></ac:layout-cell><ac:layout-cell><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"tip\" ac:schema-version=\"1\" ac:macro-id=\"9e21e6bc-65b4-4f30-a341-0dc091c2e859\"><ac:parameter ac:name=\"title\">On this Page</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"toc\" ac:schema-version=\"1\" ac:macro-id=\"c600f8c4-b8b4-4eb8-bd41-e903ed368a03\" /></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p><ac:structured-macro ac:name=\"panel\" ac:schema-version=\"1\" ac:macro-id=\"11c594ed-5883-4869-a352-0f4f6562d86e\"><ac:parameter ac:name=\"titleColor\">White</ac:parameter><ac:parameter ac:name=\"titleBGColor\">#1FA5A0</ac:parameter><ac:parameter ac:name=\"title\">Related Display Controls</ac:parameter><ac:rich-text-body><p><ac:structured-macro ac:name=\"children\" ac:schema-version=\"2\" ac:macro-id=\"51bfffa3-490f-4d94-b621-d03dad0ab1a3\"><ac:parameter ac:name=\"all\">true</ac:parameter><ac:parameter ac:name=\"page\"><ac:link><ri:page ri:content-title=\"In-Patient Department (IPD) Controls\" ri:version-at-save=\"1\" /></ac:link></ac:parameter></ac:structured-macro></p></ac:rich-text-body></ac:structured-macro><p class=\"auto-cursor-target\"><br /></p></ac:layout-cell></ac:layout-section></ac:layout>",
