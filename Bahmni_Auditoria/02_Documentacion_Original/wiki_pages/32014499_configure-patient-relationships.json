  "macroRenderedOutput": {},
  "body": {
    "storage": {
      "value": "<ac:structured-macro ac:name=\"info\" ac:schema-version=\"1\" ac:macro-id=\"ec9f94aa-a3cb-48fd-a1b5-8ce5329cb782\"><ac:rich-text-body><p>New relationship types can be added using the administration UI under&nbsp;<a href=\"https://local/openmrs/admin/person/relationshipType.list\">/openmrs/admin/person/relationshipType.list</a></p></ac:rich-text-body></ac:structured-macro><p><br /></p><h2>Steps</h2><p>1) Navigate to <em>OpenMRS, Administration, Manage Relationship Types.</em></p><p>2) Follow the instructions from below.</p><div class=\"wiki-content\"><p><span class=\"confluence-embedded-file-wrapper confluence-embedded-manual-size\"><ac:image ac:width=\"512\"><ri:attachment ri:filename=\"rtype.gif\" /></ac:image></span></p><p><a class=\"like-button\" style=\"line-height: 1.42857;\" href=\"https://bahmni.atlassian.net/wiki/display/BAH/Patient+relationships\"><span class=\"aui-icon aui-icon-small aui-iconfont-like\" style=\"color: rgb(112,112,112);\">&nbsp;</span></a></p></div>",
      "representation": "storage",
      "embeddedContent": [],
      "_expandable": {
        "content": "/rest/api/content/32014499"
      }
    },
    "view": {
      "value": "<div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-id=\"ec9f94aa-a3cb-48fd-a1b5-8ce5329cb782\" data-macro-name=\"info\"><style>[data-colorid=a52x1yqe14]{color:#707070} html[data-color-mode=dark] [data-colorid=a52x1yqe14]{color:#8f8f8f}</style><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p>New relationship types can be added using the administration UI under&nbsp;<a class=\"external-link\" href=\"https://local/openmrs/admin/person/relationshipType.list\" rel=\"nofollow\">/openmrs/admin/person/relationshipType.list</a></p></div></div><p><br /></p><h2 id=\"ConfigurePatientRelationships-Steps\">Steps</h2><p>1) Navigate to <em>OpenMRS, Administration, Manage Relationship Types.</em></p><p>2) Follow the instructions from below.</p><div class=\"wiki-content\"><p><span class=\"confluence-embedded-file-wrapper confluence-embedded-manual-size\"><span class=\"confluence-embedded-file-wrapper confluence-embedded-manual-size\"><img class=\"confluence-embedded-image\" width=\"512\" loading=\"lazy\" src=\"https://bahmni.atlassian.net/wiki/download/thumbnails/32014499/rtype.gif?version=1&amp;modificationDate=1447408884974&amp;cacheVersion=1&amp;api=v2&amp;width=512&amp;height=278\" data-image-src=\"https://bahmni.atlassian.net/wiki/download/attachments/32014499/rtype.gif?version=1&amp;modificationDate=1447408884974&amp;cacheVersion=1&amp;api=v2\" data-unresolved-comment-count=\"0\" data-linked-resource-id=\"32604665\" data-linked-resource-version=\"1\" data-linked-resource-type=\"attachment\" data-linked-resource-default-alias=\"rtype.gif\" data-base-url=\"https://bahmni.atlassian.net/wiki\" data-linked-resource-content-type=\"image/gif\" data-linked-resource-container-id=\"32014499\" data-linked-resource-container-version=\"12\" data-media-id=\"2d885af5-7d96-4c91-923d-a0f5